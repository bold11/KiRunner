<?xml version="1.0" encoding="utf-8"?>
<!-- Splash loading bar: dark track, teal-to-gold energy fill -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#26FFFFFF" />
            <stroke android:width="1dp" android:color="#552CE5D8" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="8dp" />
                <gradient android:angle="0" android:startColor="#2CE5D8" android:centerColor="#BFFFFA" android:endColor="#FFC23C" />
            </shape>
        </clip>
    </item>
</layer-list>
