<?xml version="1.0" encoding="utf-8"?>
<!-- Difficulty pill: outlined when idle, filled gold when selected, teal rim when focused (keyboard) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#FFC23C" />
            <stroke android:width="2dp" android:color="#FFF0A8" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#332CE5D8" />
            <stroke android:width="3dp" android:color="#2CE5D8" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#AA16113A" />
            <stroke android:width="1.5dp" android:color="#88B9B4E6" />
        </shape>
    </item>
</selector>
