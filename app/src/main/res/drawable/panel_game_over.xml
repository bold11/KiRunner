<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- soft outer glow -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <solid android:color="#33FF3FAE" />
        </shape>
    </item>
    <!-- panel -->
    <item android:left="6dp" android:top="6dp" android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient android:angle="270" android:startColor="#2C1D57" android:endColor="#120C2E" />
            <stroke android:width="2dp" android:color="#FF3FAE" />
        </shape>
    </item>
</layer-list>
