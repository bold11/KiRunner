<resources>
    <!-- Dark full-screen theme for both game screens (no white flash on launch) -->
    <style name="Theme.KiRunnerGame" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/ki_night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/ki_night</item>
        <item name="colorPrimary">@color/ki_teal</item>
    </style>

    <!-- LEFT / RIGHT buttons -->
    <style name="KiControlButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/btn_control</item>
        <item name="android:textColor">@color/ki_text</item>
        <item name="android:fontFamily">@font/bangers</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:drawableTint">@color/ki_teal</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
